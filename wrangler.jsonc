{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appx",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "3f475348-3085-4bf5-9f0e-17a69d197190","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "62afa073773549f782d15776c273f70f" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
